# Bluesky (AT Protocol handle + App Password from Settings -> App Passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Telegram (Bot Token from @BotFather + target @channel_username or numeric chat_id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub Gist (Personal Access Token with 'gist' scope)
GITHUB_GIST_TOKEN=

# Dev.to / Forem API Key (Settings -> Extensions -> DEV Community API Keys)
DEVTO_API_KEY=

# Mastodon (Instance domain + Access Token with 'write:statuses' scope)
MASTODON_INSTANCE=mastodon.social
MASTODON_ACCESS_TOKEN=

# Request timeout in seconds
REQUEST_TIMEOUT=15.0
